rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jeanncarllostk00@gmail.com' ||
        request.auth.token.email == 'jeannleticia00@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isApproved() {
      return isSignedIn() && (
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved'
      );
    }

    // Users collection: Private account profiles
    match /users/{userId} {
      // User can read their own profile, Admin can read any individual profile
      allow get: if isOwner(userId) || isAdmin();
      // Only Admin can list all users in the administrative dashboard
      allow list: if isAdmin();
      
      // User can create their own initial profile as 'user' with 'pending' status (or admin bootstrap)
      allow create: if isSignedIn() && (
        (isOwner(userId) && request.resource.data.role == 'user' && request.resource.data.status == 'pending') ||
        isAdmin()
      );

      // Only admin can change role and status; user can update their name but cannot promote self
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.email == resource.data.email
      );

      // Only admin can delete user profiles
      allow delete: if isAdmin();
    }

    // Global Templates collection (Master catalog)
    // Protected against client tampering: Only admin can create, modify, publish, or delete
    match /templates/{templateId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // Projects collection (Individual user customizations)
    // Bound strictly to ownerUid so users cannot access, edit, or delete another's projects
    match /projects/{projectId} {
      allow get: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
      
      // Creating a project requires user authentication and ownerUid matching request.auth.uid
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      
      // Updating a project requires ownerUid preservation and ownership
      allow update: if (isSignedIn() && 
        resource.data.ownerUid == request.auth.uid && 
        request.resource.data.ownerUid == request.auth.uid) || isAdmin();
        
      allow delete: if (isSignedIn() && resource.data.ownerUid == request.auth.uid) || isAdmin();
    }

    // Niches collection
    match /niches/{nicheId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // System configurations
    match /system/{document=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
